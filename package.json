{
  "name": "digedak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types --lang=typescript --remote --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
