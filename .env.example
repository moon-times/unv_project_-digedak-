# 이 파일을 .env.local로 복사해서 값을 채웁니다. .env.local은 커밋하지 않습니다.
# '=' 뒤에 공백 없이 값을 붙여 씁니다.

# Supabase (클라이언트에서도 사용, RLS가 데이터를 보호)
# URL: 대시보드 상단 [Connect] 또는 Project Settings → Data API
# 키: Project Settings → API Keys → Publishable key (sb_publishable_로 시작)
# Secret key(sb_secret_…)는 RLS를 무시하는 관리자 키라 여기에 넣으면 안 됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LLM API 키 (서버 전용, /api/analyze에서만 사용)
# 절대 NEXT_PUBLIC_ 접두어를 붙이지 않습니다. 제공자가 정해지면 이름을 바꿉니다.
LLM_API_KEY=
